# Development-only credentials for docker/dev/compose.yml.
# Copy to docker/dev/.env (gitignored). Never reuse these anywhere real.
# SQL Server enforces password complexity, so keep upper, lower, digit and symbol.
# Avoid quotes, $ and backslashes: the init scripts interpolate these into SQL.

ADMIN_PASSWORD=Dev_Admin_Passw0rd!
MSSQL_SA_PASSWORD=Dev_Admin_Passw0rd!
RETAIL_OWNER_PASSWORD=Dev_Owner_Passw0rd!
ANALYST_RO_PASSWORD=Dev_Analyst_Passw0rd!

# erp profile: superuser of the Odoo demo instance's own Postgres.
ODOO_DB_PASSWORD=Dev_Odoo_Passw0rd!

# Host ports (bound to 127.0.0.1). Change if they clash with local installs.
POSTGRES_PORT=5432
MARIADB_PORT=3307
MSSQL_PORT=1433
ODOO_DB_PORT=5433
ODOO_PORT=8069
