{
  "name": "@expert-ai/sample-data",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic synthetic retail dataset for tests, evals and the pack builder",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "generate": "node dist/cli.js"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@expert-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
